---
import Link from "@components/ui/link.astro";
---

<section aria-labelledby="landing-title" class="py-20 md:py-32">
  <h1
    id="landing-title"
    class="max-w-4xl text-5xl font-medium leading-[1.08] tracking-[-0.04em] text-line sm:text-6xl md:text-7xl">
    Virtual and cloud labs.<br />
    <span class="text-cool">Room to experiment.</span>
  </h1>
  <p class="mt-8 max-w-xl text-lg leading-relaxed text-cool">
    Test a deployment. Learn a new stack. Rebuild and try again. Find the right
    lab for your work, then manage it from your browser.
  </p>
  <div class="mt-8 flex flex-wrap items-center gap-4">
    <Link href="#choose-your-lab" size="md">Explore labs</Link>
    <a
      href="/pricing/"
      class="inline-flex min-h-[2.75rem] items-center px-2 text-sm font-medium text-line underline underline-offset-4"
      >Compare plans</a
    >
  </div>
</section>
