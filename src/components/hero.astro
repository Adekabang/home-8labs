---
import Link from "@components/ui/link.astro";
import LabWorkbench from "./lab-workbench.astro";
---

<section aria-labelledby="landing-title" class="pt-16 pb-10 md:pt-24 md:pb-16">
  <div class="max-w-3xl">
    <h1
      id="landing-title"
      class="text-5xl font-medium leading-[1.08] tracking-[-0.04em] text-line sm:text-6xl">
      Your next experiment<br />starts with a lab.
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-cool">
      Virtual and cloud labs for learning a stack, testing a deployment, or
      building a homelab. Choose your environment. Make it your own.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Link href="/pricing/" size="md">Compare labs</Link>
      <a
        href="#workbench"
        class="inline-flex min-h-[2.75rem] items-center px-2 text-sm font-medium text-line underline underline-offset-4"
        >Explore the workbench</a
      >
    </div>
  </div>
  <div id="workbench" class="mt-12 scroll-mt-8 md:mt-16"><LabWorkbench /></div>
</section>
