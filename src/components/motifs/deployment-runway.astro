---
// Illustrative capacity expansion, not automatic scaling or live load.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const reps = [
  { x: 36, cls: "rep r1", accent: false },
  { x: 116, cls: "rep r2", accent: false },
  { x: 196, cls: "rep r3", accent: false },
  { x: 276, cls: "rep r4", accent: true },
];
const LINKS = [
  "M180 100 C 140 124, 60 134, 60 168",
  "M180 100 C 162 128, 140 142, 140 168",
];
---

<svg
  viewBox="0 0 360 300"
  data-motif
  class:list={[className]}
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-labelledby="el-t el-d">
  <title id="el-t">Deployment capacity</title>
  <desc id="el-d"
    >An illustrative deployment expanding from two nodes to four. Capacity
    changes depend on the selected plan.</desc
  >

  <!-- load curve -->
  <g>
    <rect
      x="118"
      y="16"
      width="124"
      height="46"
      rx="6"
      fill="#FFFFFF"
      stroke="#E4E4E7"
      stroke-width="1"></rect>
    <text
      x="128"
      y="32"
      font-family="ui-monospace,monospace"
      font-size="7"
      letter-spacing="1"
      fill="#A1A1AA"
      stroke="none">CAPACITY</text
    >
    <polyline
      class="load"
      points="128,54 150,50 168,42 188,44 208,30 234,24"
      pathLength="1"
      fill="none"
      stroke="#0A0A0A"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"></polyline>
  </g>

  <!-- balancer -->
  <g class="plate" stroke="#0A0A0A" stroke-width="1.2" stroke-linejoin="round">
    <rect x="150" y="76" width="60" height="26" rx="6" fill="#FFFFFF"></rect>
    <text
      x="180"
      y="93"
      text-anchor="middle"
      font-family="ui-monospace,monospace"
      font-size="8"
      letter-spacing="1.5"
      fill="#0A0A0A"
      stroke="none">LB</text
    >
  </g>

  <!-- links to steady replicas -->
  <g class="link" fill="none" stroke="#A1A1AA" stroke-width="1.1">
    {LINKS.map((d) => <path d={d} pathLength="1" />)}
  </g>
  <!-- Additional capacity paths. -->
  <g fill="none" stroke="#A1A1AA" stroke-width="1.1">
    <path class="elink ea" d="M180 100 C 200 126, 220 142, 220 168"></path>
    <path class="elink eb" d="M180 100 C 235 122, 300 132, 300 168"></path>
  </g>

  <!-- replicas -->
  {
    reps.map((r) => (
      <g
        class={r.cls}
        stroke={r.accent ? "#C20E50" : "#0A0A0A"}
        stroke-width="1.1"
        stroke-linejoin="round">
        <rect
          x={r.x}
          y="168"
          width="48"
          height="58"
          rx="6"
          fill={r.accent ? "#FBE9EF" : "#FFFFFF"}
        />
        <line
          x1={r.x + 8}
          y1="182"
          x2={r.x + 40}
          y2="182"
          stroke-opacity="0.25"
          stroke-width="0.9"
        />
        <circle
          class="led"
          cx={r.x + 10}
          cy="176"
          r="1.8"
          fill={r.accent ? "#C20E50" : "#D4D4D8"}
          stroke="none"
        />
        <line
          x1={r.x + 10}
          y1="196"
          x2={r.x + 38}
          y2="196"
          stroke-opacity="0.3"
          stroke-width="0.9"
        />
        <line
          x1={r.x + 10}
          y1="206"
          x2={r.x + 30}
          y2="206"
          stroke-opacity="0.3"
          stroke-width="0.9"
        />
      </g>
    ))
  }
</svg>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .r3,
    .r4,
    .elink {
      animation: capacity-in 400ms ease-out backwards;
    }
    .r3,
    .ea {
      animation-delay: 250ms;
    }
    .r4,
    .eb {
      animation-delay: 850ms;
    }
  }
  @keyframes capacity-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
