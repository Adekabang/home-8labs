---
// Snapshot history with a stable, isolated experiment branch.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const edges = [
  "M58 170 L102 170",
  "M118 170 L182 170",
  "M198 170 L262 170",
  "M110 170 C 110 134, 124 110, 142 110",
  "M158 110 C 178 106, 198 96, 205 93",
  "M190 170 C 190 206, 216 230, 232 230",
];
const nodes = [
  { x: 50, y: 170, label: "v0" },
  { x: 110, y: 170, label: "v1" },
  { x: 190, y: 170, label: "v2" },
  { x: 270, y: 170, label: "v3", head: true },
  { x: 150, y: 110, label: "" },
  { x: 240, y: 230, label: "" },
];
---

<svg
  viewBox="0 0 360 300"
  data-motif
  class:list={[className]}
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-labelledby="st-t st-d">
  <title id="st-t">Lab snapshot tree</title>
  <desc id="st-d"
    >A snapshot history line with a separate branch for an isolated experiment.</desc
  >

  <!-- edges -->
  <g class="branch" fill="none" stroke="#A1A1AA" stroke-width="1.2">
    {
      edges.map((d, i) => (
        <path
          class={i === 3 || i === 4 ? "experiment-path" : undefined}
          d={d}
          pathLength="1"
        />
      ))
    }
  </g>

  <!-- snapshot nodes -->
  {
    nodes.map((n) => (
      <g>
        <rect
          x={n.x - 8}
          y={n.y - 8}
          width="16"
          height="16"
          rx="2"
          fill="#FFFFFF"
          stroke="#0A0A0A"
          stroke-width="1.2"
        />
        <rect
          x={n.x - 2.5}
          y={n.y - 2.5}
          width="5"
          height="5"
          rx="1"
          fill={n.head ? "#C20E50" : "#0A0A0A"}
          stroke="none"
        />
        {n.label && (
          <text
            x={n.x}
            y={n.y + 22}
            text-anchor="middle"
            font-family="ui-monospace,monospace"
            font-size="7"
            letter-spacing="1"
            fill="#A1A1AA"
            stroke="none">
            {n.label}
          </text>
        )}
      </g>
    ))
  }

  <!-- Isolated experiment node. -->
  <g class="breaker">
    <rect
      x="199"
      y="77"
      width="26"
      height="26"
      rx="3"
      fill="none"
      stroke="#C20E50"
      stroke-width="1"
      stroke-dasharray="3 3"
      opacity="0.5"></rect>
    <rect
      x="204"
      y="82"
      width="16"
      height="16"
      rx="2"
      fill="#FBE9EF"
      stroke="#C20E50"
      stroke-width="1.3"></rect>
    <rect
      x="209.5"
      y="87.5"
      width="5"
      height="5"
      rx="1"
      fill="#C20E50"
      stroke="none"></rect>
    <text
      x="212"
      y="68"
      text-anchor="middle"
      font-family="ui-monospace,monospace"
      font-size="7"
      letter-spacing="1"
      fill="#C20E50"
      stroke="none">lab</text
    >
  </g>
</svg>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .experiment-path {
      animation: branch-in 650ms ease-out backwards 200ms;
    }
  }
  @keyframes branch-in {
    from {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }
    to {
      stroke-dasharray: 1;
      stroke-dashoffset: 0;
    }
  }
</style>
