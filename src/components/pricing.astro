---
import { Tick } from "@components/ui/icons";
import Link from "@components/ui/link.astro";

const { plan } = Astro.props;
---

<div class="h-full">
  <div
    class:list={[
      "flex h-full w-full flex-col rounded-lg border bg-panel p-6",
      plan.popular ? "border-red-700/50" : "border-grid",
    ]}>
    <div>
      <h2 class="text-xl font-medium tracking-[-0.02em] text-line">
        {plan.name}
      </h2><p class="mt-3 text-3xl font-medium tracking-[-0.02em] text-line">
        {
          plan.price && typeof plan.price === "object"
            ? plan.price.monthly
            : plan.price
        }
      </p>
    </div><ul class="mt-6 grid gap-y-4 text-left">
      {
        plan.features.map((item) => (
          <li class="flex items-start gap-3 text-sm leading-6 text-cool">
            <Tick class="mt-1 h-4 w-4 shrink-0 text-red-ink" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul><div class="flex mt-auto pt-8">
      <Link
        href={plan.button.link || "#"}
        target={plan.button.target}
        block
        style={plan.popular ? "primary" : "outline"}>
        {plan.button.text || "Get Started"}
      </Link>
    </div>
  </div>
</div>
