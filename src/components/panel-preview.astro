---
import { Image } from "astro:assets";
import serverOverview from "../assets/docs/server-overview.webp";
---

<section
  aria-labelledby="panel-heading"
  class="border-t border-grid py-16 md:py-24">
  <h2
    id="panel-heading"
    class="max-w-3xl text-3xl font-medium leading-tight tracking-[-0.03em] text-line md:text-4xl">
    Order your lab. Open it. Get to work.
  </h2>
  <p class="mt-6 max-w-2xl text-lg leading-relaxed text-cool">
    Choose and order in Client Panel. Follow your service's management link to
    Cloud Panel to see your servers, inspect resource usage, and open the
    console.
  </p>
  <figure class="mt-10">
    <Image
      src={serverOverview}
      alt="Cloud Panel server overview with example names, assigned resources, usage charts, and server controls."
      widths={[390, 768, 1200, 1440]}
      sizes="(min-width: 1152px) 1088px, 100vw"
      class="h-auto w-full rounded-lg border border-grid"
      loading="lazy"
    />
    <figcaption class="mt-3 text-sm leading-relaxed text-muted">
      Cloud Panel. Available controls depend on your plan and permissions.
    </figcaption>
  </figure>
  <a
    href="/docs/getting-started/intro/"
    class="mt-6 inline-flex min-h-[2.75rem] items-center text-sm font-medium text-line underline underline-offset-4"
    >See how to get started</a
  >
</section>
