---
import Container from "@components/container.astro";

const columns = [
  {
    title: "Labs",
    links: [
      ["Compare plans", "/pricing/"],
      ["Virtual Labs", "https://my.8labs.id/products/virtual-labs"],
      [
        "Virtual Dedicated Labs",
        "https://my.8labs.id/products/virtual-dedicated-labs",
      ],
      ["ElasticLabs", "https://my.8labs.id/products/elasticlabs"],
      ["ElasticLabs NAT", "https://my.8labs.id/products/elasticlabs-nat"],
    ],
  },
  {
    title: "Learn",
    links: [
      ["Docs", "/docs/"],
      ["Guides", "/guides/"],
      ["Blog", "/blog/"],
      ["First access", "/docs/getting-started/intro/"],
    ],
  },
  {
    title: "Support",
    links: [
      ["Client Panel", "https://my.8labs.id"],
      ["Service status", "https://uptime.8labs.id"],
      ["Private support", "/docs/help/contact/"],
      ["Telegram community", "https://t.me/virtual_8labs"],
      ["Contact", "/contact/"],
    ],
  },
  {
    title: "Company",
    links: [
      ["Services", "/services/"],
      ["Privacy Policy", "/privacy-policy/"],
      ["Terms of Service", "/tos/"],
    ],
  },
];
---

<footer class="mt-20 border-t border-grid pb-12 pt-12">
  <Container>
    <div class="grid gap-10 md:grid-cols-[1fr_3fr]">
      <a
        href="/"
        class="self-start text-xl font-bold tracking-tight text-line"
        aria-label="8Labs home">8Labs<span class="text-red-ink">.</span></a
      >
      <nav
        aria-label="Footer"
        class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4">
        {
          columns.map(({ title, links }) => (
            <div>
              <p class="micro-label">{title}</p>
              <ul class="mt-2">
                {links.map(([label, href]) => (
                  <li>
                    <a
                      href={href}
                      class="inline-flex min-h-9 items-center text-sm text-cool hover:text-red-ink hover:underline">
                      {label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
    <div
      class="mt-10 flex flex-wrap justify-between gap-x-6 gap-y-2 border-t border-grid pt-6 text-xs text-muted">
      <p>Copyright © {new Date().getFullYear()} 8Labs. All rights reserved.</p>
      <p>Prices, stock, and support details are confirmed in Client Panel.</p>
    </div>
  </Container>
</footer>
