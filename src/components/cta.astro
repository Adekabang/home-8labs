---
import Link from "./ui/link.astro";
---

<section
  class="border-t border-grid py-16 md:py-24"
  aria-labelledby="closing-heading">
  <h2
    id="closing-heading"
    class="text-4xl font-medium leading-tight tracking-[-0.04em] text-line md:text-5xl">
    Your next lab starts here.
  </h2>
  <p class="mt-6 max-w-xl text-lg leading-relaxed text-cool">
    Choose your resources and network. Review the plan. Make room for your next
    experiment.
  </p>
  <div class="mt-8 flex flex-wrap items-center gap-4">
    <Link href="/pricing/" size="md">Compare plans</Link>
    <a
      href="/docs/getting-started/intro/"
      class="inline-flex min-h-[2.75rem] items-center px-2 text-sm font-medium text-line underline underline-offset-4"
      >Read the getting-started guide</a
    >
  </div>
</section>
