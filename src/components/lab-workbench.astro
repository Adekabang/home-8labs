---
const modes = [
  {
    id: "virtual",
    label: "Virtual Labs",
    title: "A place to learn and experiment",
    body: "Try a new stack or build a practice environment. Virtual Labs uses a nested hypervisor, making it slower than VDL and ElasticLabs.",
    layers: [
      "Bare-metal hypervisor",
      "Nested hypervisor (VM)",
      "Your Virtual Labs VM",
    ],
    href: "https://my.8labs.id/products/virtual-labs",
    action: "Explore Virtual Labs",
    note: "Provider-managed layers. Your environment is the VM.",
  },
  {
    id: "dedicated",
    label: "VDL",
    title: "Move beyond the nested layer",
    body: "Choose VDL when your project needs to avoid Virtual Labs’ extra virtualization layer. Your VM runs directly on a bare-metal hypervisor.",
    layers: ["Bare-metal hypervisor", "Your VDL VM"],
    href: "https://my.8labs.id/products/virtual-dedicated-labs",
    action: "Explore Virtual Dedicated Labs",
    note: "Direct placement, not a dedicated physical host or CPU.",
  },
  {
    id: "elastic",
    label: "ElasticLabs",
    title: "Find the fit for your next deployment",
    body: "Run your VM directly on a bare-metal hypervisor, without Virtual Labs’ nested layer. Match an ElasticLabs plan to your resources and connectivity.",
    layers: ["Bare-metal hypervisor", "Your ElasticLabs VM"],
    href: "https://my.8labs.id/products/elasticlabs",
    action: "Explore ElasticLabs",
    note: "Resources and network options depend on the selected plan.",
  },
];
---

<div class="lab-workbench" aria-labelledby="workbench-heading">
  <div class="workbench-toolbar">
    <span id="workbench-heading" class="text-sm font-medium text-line"
      >Find your starting point</span
    >
    <a href="/pricing/" class="text-xs text-muted underline underline-offset-4"
      >Compare plans</a
    >
  </div>
  <p class="workbench-axis">Choose your lab</p>
  <fieldset class="workbench-modes">
    <legend class="sr-only">Choose a lab type to explore</legend>
    {
      modes.map((mode, index) => (
        <Fragment>
          <input
            class="sr-only"
            type="radio"
            name="lab-mode"
            id={`lab-${mode.id}`}
            value={mode.id}
            checked={index === 0}
            aria-controls={`view-${mode.id}`}
          />
          <label for={`lab-${mode.id}`}>{mode.label}</label>
        </Fragment>
      ))
    }
  </fieldset>
  {
    modes.map((mode) => (
      <div id={`view-${mode.id}`} class={`workbench-view view-${mode.id}`}>
        <div class="workbench-diagram">
          <svg
            viewBox="0 0 560 300"
            role="img"
            aria-labelledby={`diagram-${mode.id}`}>
            <title id={`diagram-${mode.id}`}>
              {mode.label}: {mode.layers.join(" → ")}
            </title>
            {mode.layers.map((layer, index) => {
              const y = (mode.layers.length === 3 ? 32 : 76) + index * 88;
              const isCustomerVM = index === mode.layers.length - 1;
              return (
                <g>
                  {index > 0 && (
                    <path
                      class="workbench-route"
                      d={`M280 ${y - 36} V${y}`}
                      stroke="#c20e50"
                      stroke-width="1.5"
                      fill="none"
                      pathLength="1"
                    />
                  )}
                  <rect
                    x="36"
                    y={y}
                    width="488"
                    height="52"
                    rx="8"
                    fill={isCustomerVM ? "#fff1f5" : "#fafafa"}
                    stroke={isCustomerVM ? "#c20e50" : "#a1a1aa"}
                  />
                  <text
                    x="280"
                    y={y + 32}
                    text-anchor="middle"
                    fill={isCustomerVM ? "#a10f3a" : "#18181b"}
                    font-size="18"
                    font-family="Inter Variable, sans-serif">
                    {layer}
                  </text>
                </g>
              );
            })}
          </svg>
          <p class="text-xs leading-relaxed text-muted">{mode.note}</p>
        </div>
        <div class="workbench-description">
          <h2 class="text-2xl font-medium tracking-tight text-line">
            {mode.title}
          </h2>
          <p class="mt-4 text-base leading-relaxed text-cool">{mode.body}</p>
          <a
            href={mode.href}
            class="mt-5 inline-flex min-h-[2.75rem] items-center text-sm font-medium text-red-ink underline underline-offset-4">
            {mode.action}
          </a>
        </div>
      </div>
    ))
  }
  <div class="network-comparison">
    <fieldset class="workbench-modes network-modes">
      <legend>Choose how you connect</legend>
      <input
        class="sr-only"
        type="radio"
        name="network-mode"
        id="network-nat"
        checked
        aria-controls="network-view-nat"
      />
      <label for="network-nat">NAT</label>
      <input
        class="sr-only"
        type="radio"
        name="network-mode"
        id="network-ipv4"
        aria-controls="network-view-ipv4"
      />
      <label for="network-ipv4">Public IPv4</label>
      <input
        class="sr-only"
        type="radio"
        name="network-mode"
        id="network-ipv6"
        aria-controls="network-view-ipv6"
      />
      <label for="network-ipv6">Public IPv6</label>
    </fieldset>
    <div class="network-view network-view-nat" id="network-view-nat">
      <h3>For projects that fit shared access</h3>
      <dl>
        <div>
          <dt>Your address</dt><dd>
            Private IPv4 behind a shared public endpoint, not a dedicated public
            IPv4.
          </dd>
        </div>
        <div>
          <dt>Incoming connections</dt><dd>
            Use the plan’s assigned connection details and any supported port
            mappings.
          </dd>
        </div>
      </dl>
      <a href="https://my.8labs.id/products/elasticlabs-nat"
        >Explore ElasticLabs NAT</a
      >
    </div>
    <div class="network-view network-view-ipv4" id="network-view-ipv4">
      <h3>For services reached over IPv4</h3>
      <dl>
        <div>
          <dt>Your address</dt><dd>
            A public IPv4 address directly assigned to your VM.
          </dd>
        </div>
        <div>
          <dt>Incoming connections</dt><dd>
            Connect to the VM’s address, subject to firewall and service
            settings.
          </dd>
        </div>
      </dl>
      <a href="https://my.8labs.id/products/elasticlabs"
        >Explore ElasticLabs plans</a
      >
    </div>
    <div class="network-view network-view-ipv6" id="network-view-ipv6">
      <h3>For IPv6-ready projects</h3>
      <dl>
        <div>
          <dt>Your address</dt><dd>
            A public IPv6 address; you and your users need IPv6 connectivity.
          </dd>
        </div>
        <div>
          <dt>Incoming connections</dt><dd>
            Connect over IPv6, subject to firewall and service settings.
            IPv4-only clients need another access path.
          </dd>
        </div>
      </dl>
      <a href="https://my.8labs.id/products/elasticlabs"
        >Explore ElasticLabs plans</a
      >
    </div>
    <p class="network-note">
      Network options vary by plan, independently of lab type. <a
        href="/docs/servers/network/">See the networking guide</a
      >.
    </p>
  </div>
</div>

<style>
  .lab-workbench {
    border: 1px solid #e4e4e7;
    border-radius: 12px;
    background: white;
    overflow: clip;
    box-shadow: 0 12px 40px -28px rgb(24 24 27 / 25%);
  }
  .workbench-toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    padding: 16px 24px;
    border-bottom: 1px solid #e4e4e7;
  }
  .workbench-axis {
    margin: 20px 24px 0;
    font-size: 14px;
    font-weight: 500;
    color: #18181b;
  }
  .workbench-modes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 20px 24px 0;
  }
  .workbench-modes label {
    cursor: pointer;
    padding: 10px 16px;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 14px;
    color: #52525b;
    transition:
      color 160ms,
      background-color 160ms;
  }
  .workbench-modes label:hover {
    background: #f4f4f5;
    color: #18181b;
  }
  .workbench-modes input:checked + label {
    background: #fff1f5;
    border-color: #f5c6d5;
    color: #a10f3a;
  }
  .workbench-modes input:focus-visible + label {
    outline: 2px solid #c20e50;
    outline-offset: 2px;
  }
  .workbench-view {
    display: none;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: 32px;
    padding: 20px 32px 32px;
  }
  .lab-workbench:has(#lab-virtual:checked) .view-virtual,
  .lab-workbench:has(#lab-dedicated:checked) .view-dedicated,
  .lab-workbench:has(#lab-elastic:checked) .view-elastic {
    display: grid;
  }
  .workbench-diagram {
    min-width: 0;
  }
  .workbench-diagram svg {
    width: 100%;
    height: auto;
  }
  .workbench-diagram p {
    margin-top: 8px;
    padding-inline: 24px;
  }
  .network-comparison {
    border-top: 1px solid #e4e4e7;
    padding: 24px;
  }
  .network-modes {
    min-width: 0;
    padding: 0;
  }
  .network-modes legend {
    margin-bottom: 12px;
    font-size: 14px;
    font-weight: 500;
    color: #18181b;
  }
  .network-view {
    display: none;
    min-width: 0;
    margin-top: 20px;
  }
  .network-comparison:has(#network-nat:checked) .network-view-nat,
  .network-comparison:has(#network-ipv4:checked) .network-view-ipv4,
  .network-comparison:has(#network-ipv6:checked) .network-view-ipv6 {
    display: block;
  }
  .network-view h3 {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.025em;
    color: #18181b;
  }
  .network-view dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: 16px;
    font-size: 14px;
    line-height: 1.65;
  }
  .network-view dt {
    font-weight: 500;
    color: #18181b;
  }
  .network-view dd,
  .network-note {
    color: #52525b;
  }
  .network-view a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 12px;
    color: #a10f3a;
    font-size: 14px;
    font-weight: 500;
  }
  .network-note {
    margin-top: 12px;
    font-size: 12px;
    line-height: 1.65;
  }
  .network-comparison a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .lab-workbench a:focus-visible {
    outline: 2px solid #c20e50;
    outline-offset: 4px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .workbench-route {
      animation: route-in 700ms ease-out both;
    }
  }
  @keyframes route-in {
    from {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }
    to {
      stroke-dasharray: 1;
      stroke-dashoffset: 0;
    }
  }
  @media (max-width: 767px) {
    .network-comparison {
      padding: 20px 16px;
    }
    .network-view dl {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .network-comparison .network-modes {
      padding: 0;
    }
    .workbench-axis {
      margin-inline: 16px;
    }
    .workbench-diagram text {
      font-size: 20px;
    }
    .workbench-view {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 16px 16px 24px;
    }
    .workbench-toolbar {
      padding-inline: 16px;
    }
    .workbench-modes {
      padding-inline: 12px;
      gap: 4px;
    }
    .workbench-modes label {
      padding-inline: 12px;
    }
    .workbench-description {
      padding-inline: 8px;
    }
  }
</style>
