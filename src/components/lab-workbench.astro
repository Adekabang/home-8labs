---
const modes = [
  {
    id: "virtual",
    label: "Virtual Labs",
    title: "A VM on a nested hypervisor",
    body: "Your Virtual Labs VM runs on a nested hypervisor, which itself runs as a VM. This extra virtualization layer makes Virtual Labs slower than VDL and ElasticLabs, whose VMs run directly on a bare-metal hypervisor.",
    layers: [
      "Bare-metal hypervisor",
      "Nested hypervisor (VM)",
      "Your Virtual Labs VM",
    ],
    href: "https://my.8labs.id/products/virtual-labs",
    action: "Explore Virtual Labs",
    note: "Nesting describes the provider infrastructure, not a customer hypervisor included with your VM.",
  },
  {
    id: "dedicated",
    label: "VDL",
    title: "A VM directly on the bare-metal hypervisor",
    body: "Virtual Dedicated Labs VMs run directly on a bare-metal hypervisor, without the extra nested layer used by Virtual Labs. Choose VDL over Virtual Labs when performance matters.",
    layers: ["Bare-metal hypervisor", "Your VDL VM"],
    href: "https://my.8labs.id/products/virtual-dedicated-labs",
    action: "Explore Virtual Dedicated Labs",
    note: "Direct hypervisor placement does not mean a dedicated physical server. Check the plan for resource allocations.",
  },
  {
    id: "elastic",
    label: "ElasticLabs",
    title: "Direct hypervisor placement for ElasticLabs too",
    body: "ElasticLabs VMs also run directly on a bare-metal hypervisor. Like VDL, they avoid the extra virtualization layer used by Virtual Labs. Compare plan resources and networking before ordering.",
    layers: ["Bare-metal hypervisor", "Your ElasticLabs VM"],
    href: "https://my.8labs.id/products/elasticlabs",
    action: "Explore ElasticLabs",
    note: "Hypervisor placement and network access are separate choices. Check the selected plan for public IP or NAT access.",
  },
];
---

<div class="lab-workbench" aria-labelledby="workbench-heading">
  <div class="workbench-toolbar">
    <span id="workbench-heading" class="text-sm font-medium text-line"
      >Find your starting point</span
    >
    <span class="text-xs text-muted">Illustrative configurations</span>
  </div>
  <fieldset class="workbench-modes">
    <legend class="sr-only">Choose a lab type to explore</legend>
    {
      modes.map((mode, index) => (
        <Fragment>
          <input
            class="sr-only"
            type="radio"
            name="lab-mode"
            id={`lab-${mode.id}`}
            value={mode.id}
            checked={index === 0}
            aria-controls={`view-${mode.id}`}
          />
          <label for={`lab-${mode.id}`}>{mode.label}</label>
        </Fragment>
      ))
    }
  </fieldset>
  {
    modes.map((mode) => (
      <div id={`view-${mode.id}`} class={`workbench-view view-${mode.id}`}>
        <div class="workbench-diagram">
          <svg
            viewBox="0 0 560 300"
            role="img"
            aria-labelledby={`diagram-${mode.id}`}>
            <title id={`diagram-${mode.id}`}>
              {mode.label}: {mode.layers.join(" → ")}
            </title>
            {mode.layers.map((layer, index) => {
              const y = (mode.layers.length === 3 ? 32 : 76) + index * 88;
              const isCustomerVM = index === mode.layers.length - 1;
              return (
                <g>
                  {index > 0 && (
                    <path
                      class="workbench-route"
                      d={`M280 ${y - 36} V${y}`}
                      stroke="#c20e50"
                      stroke-width="1.5"
                      fill="none"
                      pathLength="1"
                    />
                  )}
                  <rect
                    x="36"
                    y={y}
                    width="488"
                    height="52"
                    rx="8"
                    fill={isCustomerVM ? "#fff1f5" : "#fafafa"}
                    stroke={isCustomerVM ? "#c20e50" : "#a1a1aa"}
                  />
                  <text
                    x="280"
                    y={y + 32}
                    text-anchor="middle"
                    fill={isCustomerVM ? "#a10f3a" : "#18181b"}
                    font-size="18"
                    font-family="Inter Variable, sans-serif">
                    {layer}
                  </text>
                </g>
              );
            })}
          </svg>
          <p class="text-xs leading-relaxed text-muted">{mode.note}</p>
        </div>
        <div class="workbench-description">
          <h2 class="text-2xl font-medium tracking-tight text-line">
            {mode.title}
          </h2>
          <p class="mt-4 text-base leading-relaxed text-cool">{mode.body}</p>
          <a
            href={mode.href}
            class="mt-5 inline-flex min-h-[2.75rem] items-center text-sm font-medium text-red-ink underline underline-offset-4">
            {mode.action}
          </a>
        </div>
      </div>
    ))
  }
</div>

<style>
  .lab-workbench {
    border: 1px solid #e4e4e7;
    border-radius: 12px;
    background: white;
    overflow: clip;
    box-shadow: 0 12px 40px -28px rgb(24 24 27 / 25%);
  }
  .workbench-toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    padding: 16px 24px;
    border-bottom: 1px solid #e4e4e7;
  }
  .workbench-modes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 20px 24px 0;
  }
  .workbench-modes label {
    cursor: pointer;
    padding: 10px 16px;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 14px;
    color: #52525b;
    transition:
      color 160ms,
      background-color 160ms;
  }
  .workbench-modes label:hover {
    background: #f4f4f5;
    color: #18181b;
  }
  .workbench-modes input:checked + label {
    background: #fff1f5;
    border-color: #f5c6d5;
    color: #a10f3a;
  }
  .workbench-modes input:focus-visible + label {
    outline: 2px solid #c20e50;
    outline-offset: 2px;
  }
  .workbench-view {
    display: none;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: 32px;
    padding: 20px 32px 32px;
  }
  .lab-workbench:has(#lab-virtual:checked) .view-virtual,
  .lab-workbench:has(#lab-dedicated:checked) .view-dedicated,
  .lab-workbench:has(#lab-elastic:checked) .view-elastic {
    display: grid;
  }
  .workbench-diagram {
    min-width: 0;
  }
  .workbench-diagram svg {
    width: 100%;
    height: auto;
  }
  .workbench-diagram p {
    margin-top: 8px;
    padding-inline: 24px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .workbench-route {
      animation: route-in 700ms ease-out both;
    }
  }
  @keyframes route-in {
    from {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }
    to {
      stroke-dasharray: 1;
      stroke-dashoffset: 0;
    }
  }
  @media (max-width: 767px) {
    .workbench-diagram text {
      font-size: 20px;
    }
    .workbench-view {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 16px 16px 24px;
    }
    .workbench-toolbar {
      padding-inline: 16px;
    }
    .workbench-modes {
      padding-inline: 12px;
      gap: 4px;
    }
    .workbench-modes label {
      padding-inline: 12px;
    }
    .workbench-description {
      padding-inline: 8px;
    }
  }
</style>
