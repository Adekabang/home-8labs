---
const placements = [
  {
    id: "nested",
    name: "Virtual Labs",
    nested: true,
    plans: [{ label: "Virtual Labs plans", slug: "virtual-labs" }],
  },
  {
    id: "direct",
    name: "VDL and ElasticLabs",
    nested: false,
    plans: [
      { label: "VDL plans", slug: "virtual-dedicated-labs" },
      { label: "ElasticLabs plans", slug: "elasticlabs" },
    ],
  },
];

const networks = [
  {
    id: "nat",
    label: "NAT",
    path: ["IPv4 client", "Shared endpoint", "Private VM"],
    detail:
      "Your VM has a private IPv4 address. For incoming connections, use the shared public endpoint and the port mapping assigned by your plan, if supported.",
    href: "https://my.8labs.id/products/elasticlabs-nat",
    action: "Explore ElasticLabs NAT",
  },
  {
    id: "ipv4",
    label: "Public IPv4",
    path: ["IPv4 client", "VM’s public IPv4"],
    detail:
      "Clients connect to the public IPv4 address assigned to your VM. The service must be listening and the firewall must allow the connection.",
    href: "https://my.8labs.id/products/elasticlabs",
    action: "Explore ElasticLabs plans",
  },
  {
    id: "ipv6",
    label: "Public IPv6",
    path: ["IPv6 client", "VM’s public IPv6"],
    detail:
      "IPv6 clients connect to your VM’s public IPv6 address, subject to firewall and service settings. IPv4-only clients need another access path.",
    href: "https://my.8labs.id/products/elasticlabs",
    action: "Explore ElasticLabs plans",
  },
];
---

<div>
  <div class="mx-auto max-w-2xl text-center">
    <h2 id="workbench-heading" class="section-title">
      Know what you are renting
    </h2>
    <p class="section-lede">
      What sits under your VM, and how traffic reaches it, decide how your lab
      behaves. So we draw both.
    </p>
  </div>
  <div class="workbench-panel">
    <div class="py-6 md:py-8">
      <h3 class="font-sans text-xl font-medium tracking-tight text-line">
        Where does your VM run?
      </h3>
      <p class="mt-2 text-cool">
        Both setups use a bare-metal hypervisor. What changes is the layer
        beneath your VM.
      </p>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        {
          placements.map(({ id, name, nested, plans }) => (
            <figure>
              <h4 class="mb-3 font-sans text-base font-medium text-line">
                {name}
              </h4>
              <svg
                class:list={["stack", !nested && "stack-direct"]}
                viewBox={nested ? "0 0 320 174" : "0 58 320 116"}
                role="img"
                aria-labelledby={`title-${id}`}
                aria-describedby={`desc-${id}`}>
                <title id={`title-${id}`}>
                  {name}: {nested ? "nested" : "direct"} placement
                </title>
                <desc id={`desc-${id}`}>
                  {nested
                    ? "Your VM runs on a nested hypervisor, itself a VM on the bare-metal hypervisor."
                    : "Your VM runs directly on the bare-metal hypervisor, with no nested hypervisor in between."}
                </desc>
                {nested && (
                  <defs>
                    <pattern
                      id="nested-hatch"
                      width="7"
                      height="7"
                      patternUnits="userSpaceOnUse">
                      <path
                        d="M-1 1l2-2M0 7l7-7M6 8l2-2"
                        stroke="currentColor"
                        opacity=".18"
                      />
                    </pattern>
                  </defs>
                )}
                <g class="guest">
                  <rect
                    class="band"
                    x="1"
                    y={nested ? 1 : 59}
                    width="318"
                    height="56"
                  />
                  <rect
                    class="inset"
                    x="6"
                    y={nested ? 6 : 64}
                    width="308"
                    height="46"
                  />
                  <text x="160" y={nested ? 29 : 87}>
                    Your VM
                  </text>
                </g>
                {nested && (
                  <g class="extra">
                    <rect
                      x="1"
                      y="58"
                      width="318"
                      height="57"
                      fill="url(#nested-hatch)"
                      stroke="currentColor"
                    />
                    <rect class="inset" x="6" y="63" width="308" height="47" />
                    <text x="160" y="87">
                      Nested hypervisor (VM)
                    </text>
                  </g>
                )}
                <g class="host">
                  <rect class="band" x="1" y="116" width="318" height="57" />
                  <rect class="inset" x="6" y="121" width="308" height="47" />
                  <text x="160" y="145">
                    Bare-metal hypervisor
                  </text>
                </g>
              </svg>
              <figcaption class="mt-3 text-sm text-cool">
                <p>
                  {nested
                    ? "Virtual Labs is the free tier. Your VM runs inside another VM (the hatched layer), which is fine for practice and slower for heavy work."
                    : "Virtual Dedicated Labs (VDL) and ElasticLabs skip the nested layer. You still share the physical host and its CPUs with other VMs."}
                </p>
                <div class="flex flex-wrap gap-x-5">
                  {plans.map(({ label, slug }) => (
                    <a
                      class="workbench-link"
                      href={`https://my.8labs.id/products/${slug}`}>
                      {label}
                    </a>
                  ))}
                </div>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>

    <div class="network border-t border-grid py-6 md:py-8">
      <fieldset class="flex flex-wrap gap-1">
        <legend class="mb-3 text-xl font-medium text-line"
          >How can someone reach your VM?</legend
        >
        {
          networks.map(({ id, label }, index) => (
            <Fragment>
              <input
                class="sr-only"
                type="radio"
                name="network-mode"
                id={`network-${id}`}
                checked={index === 0}
                aria-controls={`network-view-${id}`}
              />
              <label for={`network-${id}`}>{label}</label>
            </Fragment>
          ))
        }
      </fieldset>
      {
        networks.map(({ id, path, detail, href, action }) => (
          <div class="network-view mt-4" id={`network-view-${id}`}>
            <ol class="network-path" aria-label="Incoming connection path">
              {path.map((node, index) => (
                <li>
                  {index > 0 && (
                    <span class="packet-track" aria-hidden="true">
                      <span class="packet" />
                    </span>
                  )}
                  {node}
                </li>
              ))}
            </ol>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-cool">
              {detail}
            </p>
            <a class="workbench-link" href={href}>
              {action}
            </a>
          </div>
        ))
      }
      <p class="mt-2 text-sm text-muted">
        Network options vary by plan. <a
          class="underline underline-offset-4"
          href="/docs/servers/network/">See the networking guide</a
        >.
      </p>
    </div>
  </div>
</div>

<script>
  const stacks = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.intersectionRatio < 0.75) continue;
        entry.target.classList.add("revealed");
        stacks.unobserve(entry.target);
      }
    },
    { threshold: 0.75 },
  );
  function observeStacks() {
    stacks.disconnect();
    if (!document.hidden)
      document
        .querySelectorAll(".stack:not(.revealed)")
        .forEach((stack) => stacks.observe(stack));
  }
  observeStacks();
  document.addEventListener("visibilitychange", observeStacks);

  function playPath(network: Element, path: Element) {
    network.querySelectorAll(".packet").forEach((packet) => {
      packet.getAnimations().forEach((animation) => animation.cancel());
    });
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    path.querySelectorAll(".packet").forEach((packet, hop) => {
      packet.animate(
        [
          { transform: "translateX(0)", opacity: 0 },
          { opacity: 1, offset: 0.15 },
          { opacity: 1, offset: 0.85 },
          { transform: "var(--packet-end)", opacity: 0 },
        ],
        { duration: 800, delay: hop * 800, easing: "linear" },
      );
    });
  }

  for (const network of document.querySelectorAll(".network")) {
    const paths = network.querySelectorAll(".network-path");
    let played = false;
    const observer = new IntersectionObserver(
      (entries) => {
        if (played || document.hidden) return;
        const visible = entries.find(
          (entry) => entry.isIntersecting && entry.intersectionRatio >= 0.75,
        );
        if (visible) play(visible.target);
      },
      { threshold: 0.75 },
    );

    function observePaths() {
      observer.disconnect();
      if (!document.hidden) paths.forEach((path) => observer.observe(path));
    }

    function play(path: Element) {
      played = true;
      observer.disconnect();
      document.removeEventListener("visibilitychange", observePaths);
      playPath(network, path);
    }

    observePaths();
    document.addEventListener("visibilitychange", observePaths);
    network.addEventListener("click", ({ target }) => {
      if (
        !(target instanceof HTMLInputElement) ||
        target.name !== "network-mode"
      )
        return;
      const path = document
        .getElementById(target.getAttribute("aria-controls") ?? "")
        ?.querySelector(".network-path");
      if (path) play(path);
    });
  }
</script>

<style>
  .workbench-panel {
    margin-top: 2.5rem;
    padding-inline: clamp(1rem, 3vw, 2rem);
    background: #fafafa;
  }
  .stack {
    display: block;
    width: 100%;
    color: #0a0a0a;
  }
  .stack .band {
    fill: #fff;
    stroke: #0a0a0a;
    stroke-width: 1.5;
  }
  .stack .extra > rect:first-of-type {
    stroke-width: 1.5;
  }
  .stack .inset {
    fill: none;
    stroke: currentColor;
    stroke-dasharray: 3 3;
  }
  .stack .extra,
  .stack pattern {
    color: #c20e50;
  }
  .stack text {
    font:
      600 12px ui-monospace,
      monospace;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-anchor: middle;
    dominant-baseline: central;
    fill: currentColor;
  }
  /* The direct stack is one layer shorter. On wide screens, push it down by
     that layer's height (58/320 of the width) so both hosts share a baseline. */
  @media (min-width: 768px) {
    .stack-direct {
      margin-top: 18.125%;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .stack.revealed .host,
    .stack.revealed .extra,
    .stack.revealed .guest {
      animation: place-layer 450ms cubic-bezier(0.23, 1, 0.32, 1) backwards;
    }
    .stack.revealed .extra,
    .stack.revealed .guest {
      animation-delay: 180ms;
    }
    .stack.revealed:has(.extra) .guest {
      animation-delay: 360ms;
    }
  }
  @keyframes place-layer {
    from {
      opacity: 0.25;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .workbench-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #c20e50;
    font-size: 0.875rem;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .network label {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    cursor: pointer;
    border: 1.5px solid #0a0a0a;
    background: #fff;
    font:
      600 0.6875rem ui-monospace,
      monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition:
      background-color 150ms ease-out,
      transform 150ms ease-out;
  }
  .network label:active {
    transform: scale(0.97);
  }
  @media (hover: hover) {
    .network label:hover {
      background: #f4f4f5;
    }
  }
  .network input:checked + label {
    color: #c20e50;
    border-color: currentColor;
    background: #fbeaf0;
  }
  .network input:focus-visible + label {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
  .network-view {
    display: none;
  }
  .network:has(#network-nat:checked) #network-view-nat,
  .network:has(#network-ipv4:checked) #network-view-ipv4,
  .network:has(#network-ipv6:checked) #network-view-ipv6 {
    display: block;
  }
  .network-path {
    --hop-width: clamp(1.5rem, 6vw, 5rem);
    --packet-end: translateX(100%);
    display: flex;
    align-items: stretch;
    gap: var(--hop-width);
  }
  .network-path li {
    position: relative;
    display: grid;
    flex: 1;
    min-height: 4rem;
    align-items: center;
    padding: 0.75em;
    border: 1.5px solid #0a0a0a;
    outline: 1px dashed #0a0a0a;
    outline-offset: -6px;
    background: #fff;
    font:
      600 0.8125rem/1.4 ui-monospace,
      monospace;
    letter-spacing: 0.06em;
    color: #0a0a0a;
    text-align: center;
    text-transform: uppercase;
  }
  /* The sender is an outside actor; the last box is the node that matters. */
  .network-path li:first-child {
    border-color: #71717a;
    outline-color: #71717a;
    background: #f4f4f5;
  }
  .network-path li:last-child {
    border-color: #c20e50;
    outline-color: #c20e50;
    background:
      repeating-linear-gradient(
        45deg,
        rgb(194 14 80 / 0.14) 0 1px,
        transparent 1px 7px
      ),
      #fff;
  }
  .packet-track {
    position: absolute;
    right: 100%;
    top: 50%;
    width: calc(var(--hop-width) + 1px);
    border-top: 1.75px solid #1d4ed8;
    color: #1d4ed8;
  }
  .packet-track::before,
  .packet-track::after {
    content: "";
    position: absolute;
    top: -4px;
    width: 6px;
    height: 6px;
    background: currentColor;
  }
  .packet-track::before {
    left: -3px;
  }
  .packet-track::after {
    right: -3px;
  }
  .packet {
    position: absolute;
    inset: -1px 0 auto;
    opacity: 0;
    pointer-events: none;
  }
  .packet::before {
    content: "";
    position: absolute;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #c20e50;
    transform: translate(-50%, -50%);
  }
  @media (max-width: 480px) {
    .network-path {
      flex-direction: column;
      --packet-end: translateY(100%);
    }
    .network-path li {
      min-height: 3rem;
    }
    .packet-track {
      right: auto;
      left: 50%;
      top: auto;
      bottom: 100%;
      width: 0;
      height: calc(var(--hop-width) + 1px);
      border-top: 0;
      border-left: 1.75px solid #1d4ed8;
    }
    .packet-track::before,
    .packet-track::after {
      left: -4px;
      right: auto;
    }
    .packet-track::before {
      top: -3px;
    }
    .packet-track::after {
      top: auto;
      bottom: -3px;
    }
    .packet {
      inset: 0 auto 0 -1px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .packet {
      display: none;
    }
  }
</style>
