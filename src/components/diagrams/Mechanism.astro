---
import { sceneFor, type SceneId } from './scenes';
interface Props { id:SceneId; title:string; caption:string }
const {id,title,caption} = Astro.props;
const {nodes,edges,states,groups} = sceneFor(id);
const halfWidth = id==='replication' ? 45 : 57;
---
<figure class="mechanism">
  <fieldset>
    <legend>{title}</legend>
    <div class="choices">
      {states.map(([control,,,outcome],i)=><label><input type="radio" name={`scene-${id}`} value={i} checked={i===0} aria-description={outcome}/><span>{control}</span></label>)}
    </div>
    {states.map(([,activeEdges,activeNodes,outcome,offline=[]],step)=><div class="frame" data-step={step}>
      <svg viewBox="0 0 320 198" aria-hidden="true">
        <defs><marker id={`${id}-${step}-arrow`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="4" markerHeight="4" orient="auto-start-reverse"><path d="M0 0 L8 4 L0 8 Z" fill="context-stroke"/></marker></defs>
        {groups?.map(([x,y,w,h,label])=><g><rect class="boundary" x={x} y={y} width={w} height={h}/><text class="zone" x={x+6} y={y+14}>{label}</text></g>)}
        {edges.map(([d,label,x,y],i)=><g class:list={['wire', {lit:activeEdges.includes(i)}]}><path class="line" d={d} marker-end={`url(#${id}-${step}-arrow)`}/>{activeEdges.includes(i)&&<path class="pulse" pathLength="100" d={d}/>}<text class="edge-label" x={x} y={y}>{label}</text></g>)}
        {nodes.map(([x,y,label,detail],i)=><g class:list={['node',{current:activeNodes.includes(i),offline:offline.includes(i)}]} transform={`translate(${x} ${y})`}>
          <rect x={-halfWidth} y="-18" width={halfWidth*2} height="36" rx="2"/><text y={detail?-2:4}>{label}</text>{detail&&<text class="detail" y="12">{detail}</text>}
          {offline.includes(i)&&<text class="fault" x={halfWidth-2} y="-10">×</text>}
        </g>)}
      </svg>
      <p class="outcome"><b>{id==='proxmox'?'Hasil':'Result'}</b> {outcome}</p>
    </div>)}
  </fieldset>
  <figcaption>{caption}</figcaption>
</figure>
<style>
  figure{margin:1.75rem 0;color:var(--nb-foreground)}fieldset{min-inline-size:0;margin:0;padding:.75rem;border:1px solid var(--nb-border);border-radius:.5rem}legend{padding:0 .35rem;font-weight:650}.choices{display:flex;flex-wrap:wrap;gap:.35rem}label{position:relative;cursor:pointer}input{position:absolute;opacity:0}label span{display:inline-flex;align-items:center;padding:.25rem .7rem;min-height:2.5rem;border:1px solid var(--nb-border);border-radius:.3rem;font-size:.875rem}input:checked+span{background:var(--nb-foreground);color:var(--nb-background)}input:focus-visible+span{outline:2px solid var(--nb-brand);outline-offset:2px}
  .frame{display:none}fieldset:has(input[value="0"]:checked) [data-step="0"],fieldset:has(input[value="1"]:checked) [data-step="1"],fieldset:has(input[value="2"]:checked) [data-step="2"]{display:block}svg{display:block;width:100%;max-width:29rem;margin:1rem auto .5rem;overflow:visible}svg text{font:600 12px ui-monospace,monospace;fill:currentColor;text-anchor:middle}.boundary{fill:none;stroke:var(--nb-muted-foreground);stroke-dasharray:3 4}.zone{text-anchor:start;font-size:11px}.line,.pulse{fill:none;stroke:currentColor;stroke-width:1.5}.wire{color:var(--nb-muted-foreground)}.wire:not(.lit) .line{stroke-dasharray:3 4}.lit{color:var(--nb-brand)}.lit .line{stroke-width:2.6}.edge-label,.detail{font-size:11px}.node rect{fill:var(--nb-background);stroke:var(--nb-muted-foreground)}.current rect{stroke:var(--nb-brand);stroke-width:2}.offline rect{stroke-dasharray:4 3}.fault{font-size:20px;paint-order:stroke;stroke:var(--nb-background);stroke-width:3px}.pulse{display:none}.outcome{margin:0;min-height:3lh;font-size:.9375rem;line-height:1.5}.outcome b{margin-right:.35em}figcaption{margin-top:.55rem;color:var(--nb-muted-foreground);font-size:.875rem}
  @media(prefers-reduced-motion:no-preference){.lit .pulse{display:block;stroke:var(--nb-foreground);stroke-width:3;stroke-dasharray:6 100;animation:trace .48s ease-out both}@keyframes trace{from{stroke-dashoffset:6}to{stroke-dashoffset:-100}}}
</style>
