---
// Plan considerations, not a sequence of deployment steps.
const considerations = [
  {
    title: "Virtualization",
    body: "Need to run a hypervisor? Choose a nested lab. Need a VM for your stack? Compare the dedicated or cloud options.",
  },
  {
    title: "Network access",
    body: "Public IPv6, public IPv4, and private NAT are different options. Check how you will connect before ordering.",
  },
  {
    title: "Recovery",
    body: "Check which backup and snapshot controls your plan includes. An on-server snapshot is not an independent backup.",
  },
  {
    title: "Price and availability",
    body: "Use the pricing guide to compare families. Client Panel confirms current stock, billing units, and the final price.",
  },
];
---

<section
  class="border-t border-grid py-16 md:py-24"
  aria-labelledby="plan-boundaries-heading">
  <h2
    id="plan-boundaries-heading"
    class="max-w-2xl text-3xl font-medium leading-tight tracking-[-0.03em] text-line md:text-4xl">
    Know what your lab includes
  </h2>
  <div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2">
    {
      considerations.map((item) => (
        <div>
          <h3 class="text-lg font-medium text-line">{item.title}</h3>
          <p class="mt-3 text-base leading-relaxed text-cool">{item.body}</p>
        </div>
      ))
    }
  </div>
</section>
