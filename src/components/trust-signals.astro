---
const trustItems = [
  {
    title: "Check service status",
    description:
      "Check for an active incident before troubleshooting your server. If the status page is unavailable, contact support through Client Panel.",
    href: "https://uptime.8labs.id",
    label: "Open status",
    external: true,
  },
  {
    title: "Find a guide or ask for help",
    description:
      "Start with the guides for access, server controls, and recovery. For an issue with your account or service, use the private support path in Client Panel.",
    href: "/docs/",
    label: "Read docs",
    external: false,
  },
  {
    title: "Keep an independent backup",
    description:
      "Keep a separate copy of important data. A snapshot can share the server's storage and is not a replacement for an independent backup. Review your plan's recovery options.",
    href: "/docs/servers/backups/",
    label: "Understand backups",
    external: false,
  },
  {
    title: "Report a security concern",
    description:
      "Send account, security, or abuse concerns through a private support channel. Include the affected service and a redacted error, never passwords or access tokens.",
    href: "/docs/help/contact/",
    label: "Contact support",
    external: false,
  },
];
---

<section class="py-12 md:py-16" aria-labelledby="help-heading">
  <h2
    id="help-heading"
    class="text-2xl font-medium tracking-[-0.03em] text-line md:text-3xl">
    Help when you need it
  </h2>
  <p class="mt-4 max-w-2xl text-base leading-relaxed text-cool">
    Find a guide, check service status, or contact support. Keep service and
    account details in private support channels.
  </p>
  <div class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2">
    {
      trustItems.map((item) => (
        <div>
          <h3 class="text-lg font-medium text-line">{item.title}</h3>
          <p class="mt-3 text-base leading-relaxed text-cool">
            {item.description}
          </p>
          <a
            href={item.href}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
            class="mt-4 inline-flex min-h-[2.75rem] items-center text-sm font-medium text-line underline underline-offset-4">
            {item.label}
          </a>
        </div>
      ))
    }
  </div>
</section>
