---
const products = [
  {
    name: "Virtual Labs",
    use: "Learn by doing",
    description:
      "A VM for your next experiment. Nested virtualization makes it slower than VDL and ElasticLabs.",
    href: "https://my.8labs.id/products/virtual-labs",
  },
  {
    name: "Virtual Dedicated Labs",
    use: "Skip the nested layer",
    description:
      "Your VM runs directly on a bare-metal hypervisor. Bring your stack and choose the resources it needs.",
    href: "https://my.8labs.id/products/virtual-dedicated-labs",
  },
  {
    name: "ElasticLabs",
    use: "Match your next project",
    description:
      "Direct bare-metal hypervisor placement, with resource tiers and NAT or public-IP plans to compare.",
    href: "https://my.8labs.id/products/elasticlabs",
  },
];
---

<section
  id="choose-your-lab"
  aria-labelledby="catalog-heading"
  class="scroll-mt-8 py-12 md:py-16">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <h2
      id="catalog-heading"
      class="max-w-xl text-3xl font-medium leading-tight tracking-[-0.03em] text-line md:text-4xl">
      Different projects.<br />Different starting points.
    </h2>
    <a
      href="/pricing/"
      class="inline-flex min-h-[2.75rem] items-center text-sm font-medium text-line underline underline-offset-4"
      >Compare all plans</a
    >
  </div>
  <div class="mt-8 grid gap-8 md:grid-cols-3">
    {
      products.map((product) => (
        <div class="flex flex-col items-start border-t border-grid pt-6">
          <p class="text-sm text-muted">{product.use}</p>
          <h3 class="mt-3 text-xl font-medium text-line">{product.name}</h3>
          <p class="mt-4 text-base leading-relaxed text-cool">
            {product.description}
          </p>
          <a
            href={product.href}
            class="mt-auto inline-flex min-h-[2.75rem] items-center pt-5 text-sm font-medium text-red-ink underline underline-offset-4">
            View plans
          </a>
        </div>
      ))
    }
  </div>
  <p class="mt-6 text-sm leading-relaxed text-muted">
    Current availability and final prices are in Client Panel.
  </p>
</section>
