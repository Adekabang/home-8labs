---
import { Image } from "astro:assets";
import blankonImage from "assets/blankon-foundation-color.svg";
import genreJatengImage from "assets/genre-jateng.png";

const partners = [
  {
    name: "Genre Jawa Tengah",
    image: genreJatengImage,
    url: "https://genrejateng.or.id",
    domain: "genrejateng.or.id",
    description:
      "A social movement empowering young people across Jawa Tengah.",
  },
  {
    name: "BlankOn Foundation",
    image: blankonImage,
    url: "https://blankon.id",
    domain: "blankon.id",
    description:
      "Supporting Indonesian open source through BlankOn Linux and education.",
  },
];
---

<section
  class="community-section border-t border-grid py-10 md:py-12"
  aria-labelledby="community-heading">
  <header class="community-header">
    <h2
      id="community-heading"
      class="text-2xl font-medium tracking-[-0.03em] text-line">
      Explore the community
    </h2>
    <p class="text-base leading-relaxed text-cool">
      Meet fellow lab builders and Indonesia’s youth and open-source
      communities.
    </p>
  </header>
  <div class="community-grid">
    <div class="community-invitation">
      <div>
        <p class="community-channel">8Labs community</p>
        <h3>Keep the conversation going.</h3>
        <p class="community-description">
          Ask lab questions. Share what you’re building.
        </p>
      </div>
      <div class="community-invitation-actions">
        <a
          href="https://t.me/virtual_8labs"
          target="_blank"
          rel="noopener noreferrer"
          class="community-join">Join 8Labs on Telegram</a
        >
        <p class="community-privacy">
          Keep account details and secrets private. For service support, use{
            " "
          }
          <a
            href="https://my.8labs.id"
            target="_blank"
            rel="noopener noreferrer">Client Panel</a
          >.
        </p>
      </div>
    </div>
    {
      partners.map((partner) => (
        <a
          href={partner.url}
          target="_blank"
          rel="noopener noreferrer"
          class="community-organization"
          aria-label={`Visit ${partner.name} at ${partner.domain}`}>
          <div class="community-logo">
            <Image src={partner.image} alt="" loading="lazy" />
          </div>
          <h3>{partner.name}</h3>
          <p class="community-description">{partner.description}</p>
          <span class="community-domain">
            {partner.domain}
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true">
              <path d="M7 17 17 7M7 7h10v10" />
            </svg>
          </span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .community-header {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .community-header p {
    max-width: 38rem;
  }

  .community-grid {
    display: grid;
    gap: 1rem;
  }

  .community-invitation,
  .community-organization {
    min-width: 0;
    border: 1px solid #e4e4e7;
    border-radius: 12px;
    padding: 1.5rem;
    color: #18181b;
  }

  .community-invitation {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.75rem;
    background: #fafafa;
  }

  .community-channel {
    margin-bottom: 0.75rem;
    color: #c20e50;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .community-section h3 {
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }

  .community-invitation h3 {
    max-width: 14rem;
    font-size: 1.75rem;
  }

  .community-description {
    margin-top: 0.75rem;
    color: #52525b;
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .community-join {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.625rem 1rem;
    border: 1px solid #c20e50;
    border-radius: 8px;
    background: #c20e50;
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .community-join:hover {
    border-color: #18181b;
    background: #18181b;
  }

  .community-privacy {
    margin-top: 1rem;
    color: #52525b;
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .community-privacy a {
    color: #18181b;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .community-privacy a:hover {
    color: #c20e50;
  }

  .community-organization {
    display: flex;
    flex-direction: column;
    background: #fff;
  }

  .community-organization:hover {
    border-color: #c20e50;
  }

  .community-organization:hover h3,
  .community-organization:hover .community-domain {
    color: #c20e50;
  }

  .community-logo {
    display: flex;
    align-items: center;
    min-height: 6rem;
    margin-bottom: 1.25rem;
  }

  .community-logo img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 6rem;
    object-fit: contain;
  }

  .community-domain {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .community-domain svg {
    flex-shrink: 0;
  }

  .community-section a:focus-visible {
    outline: 2px solid #c20e50;
    outline-offset: 4px;
  }

  @media (min-width: 1024px) {
    .community-header {
      grid-template-columns: 1fr 1fr;
      align-items: start;
      gap: 2rem;
    }

    .community-grid {
      grid-template-columns: 1.15fr 1fr 1fr;
    }
  }
</style>
