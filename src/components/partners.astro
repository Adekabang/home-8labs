---
import { Image } from "astro:assets";
import blankonImage from "assets/blankon-foundation-color.svg";
import genreJatengImage from "assets/genre-jateng.png";

const partners = [
  {
    name: "Genre Jawa Tengah",
    image: genreJatengImage,
    url: "https://genrejateng.or.id",
  },
  {
    name: "BlankOn Foundation",
    image: blankonImage,
    url: "https://blankon.id",
  },
];
---

<section
  class="border-t border-grid py-16 md:py-24"
  aria-labelledby="community-heading">
  <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
    <div>
      <h2
        id="community-heading"
        class="text-3xl font-medium tracking-[-0.03em] text-line md:text-4xl">
        Explore the community
      </h2>
      <p class="mt-4 max-w-md text-base leading-relaxed text-cool">
        Discover community initiatives and open-source projects beyond your lab.
        Visit their sites to learn about their work.
      </p>
      <a
        href="https://t.me/virtual_8labs"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex min-h-[2.75rem] items-center text-sm font-medium text-red-ink underline underline-offset-4">
        Join the 8Labs community
      </a>
    </div>
    <div class="grid min-w-0 gap-4">
      {
        partners.map((partner) => (
          <a
            href={partner.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex min-w-0 flex-col items-start gap-4 py-3 transition-colors hover:text-red-ink sm:flex-row sm:items-center sm:gap-5"
            title={partner.name}>
            <Image
              src={partner.image}
              alt={partner.name}
              class="h-10 w-auto max-w-full object-contain"
              loading="lazy"
            />
            <span class="text-base font-medium text-line">{partner.name}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
