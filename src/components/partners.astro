---
import { Image } from "astro:assets";
import blankon from "assets/blankon-foundation-color.svg";
import genre from "assets/genre-jateng.png";

// Customer words, quoted as written in support tickets (2025–2026).
// First name and role only: no surnames or social handles.
const lead = {
  quote:
    "Sangat membantu untuk ngoprek dibanding pake vm dilaptop suara fan seketika menjadi jet tempur.",
  name: "Aziz",
};
const quotes = [
  {
    quote:
      "Ternyata di 8labs lancar banget, stabil, dan bikin saya sadar pentingnya siap-siap ke arah IPv6.",
    name: "Toni",
    role: "Software engineer",
  },
  {
    quote:
      "Setupnya cepat, panelnya gampang dipakai, lumayan untuk testing service service baru.",
    name: "Yoga",
    role: "DevSecOps / platform engineer",
  },
  {
    quote:
      "Mantep bgt buat staging dan trial app. Thanks buat tim 8labs & community yang support.",
    name: "Christian",
    role: "CTO",
  },
];

const logos = [
  {
    name: "Genre Jawa Tengah",
    image: genre,
    href: "https://genrejateng.or.id",
  },
  { name: "BlankOn Foundation", image: blankon, href: "https://blankon.id" },
];
---

<div class="text-center">
  <h2 id="community-heading" class="section-title">
    <span class="text-red-ink">1,750+</span> machines deployed
  </h2>
  <figure class="mx-auto mt-10 max-w-3xl">
    <blockquote lang="id" class="lead-quote">
      <p>“{lead.quote}”</p>
    </blockquote>
    <figcaption class="mt-4 text-sm text-muted">
      <span class="font-medium text-line">{lead.name}</span>, 8Labs customer
    </figcaption>
  </figure>
</div>

<ul class="quotes">
  {
    quotes.map(({ quote, name, role }) => (
      <li>
        <figure class="flex h-full flex-col">
          <blockquote lang="id" class="text-base leading-relaxed text-line">
            <p>“{quote}”</p>
          </blockquote>
          <figcaption class="mt-auto pt-4 text-sm text-muted">
            <span class="font-medium text-line">{name}</span>, {role}
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>

<div class="mt-10 text-center">
  <p class="text-sm text-muted">
    Quoted as written, from 18 testimonials customers sent in 2025 and 2026.{
      " "
    }
    <a
      class="text-line underline underline-offset-4"
      href="https://t.me/virtual_8labs">Join 8Labs on Telegram</a
    >.
  </p>
  <p class="micro-label mt-10">Trusted by</p>
  <div class="mt-4 flex flex-wrap items-center justify-center gap-x-12 gap-y-4">
    {
      logos.map(({ name, image, href }) => (
        <a href={href} class="inline-flex min-h-11 items-center">
          <Image
            src={image}
            alt={name}
            class="h-auto max-h-12 w-auto max-w-36 object-contain"
            width={288}
            loading="lazy"
          />
        </a>
      ))
    }
  </div>
</div>

<style>
  .lead-quote {
    font-family: "Bricolage Grotesque Variable", "Inter Variable", sans-serif;
    font-size: clamp(1.375rem, 2.6vw, 1.875rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: #0a0a0a;
    text-wrap: balance;
  }
  .lead-quote p {
    font-family: inherit;
  }
  .quotes {
    display: grid;
    margin-top: 3rem;
    border-block: 1px dashed #d4d4d8;
  }
  .quotes li {
    padding: 1.5rem 0;
  }
  .quotes li + li {
    border-top: 1px dashed #d4d4d8;
  }
  @media (min-width: 768px) {
    .quotes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .quotes li {
      padding: 1.75rem 2rem;
    }
    .quotes li:first-child {
      padding-left: 0;
    }
    .quotes li:last-child {
      padding-right: 0;
    }
    .quotes li + li {
      border-top: 0;
      border-left: 1px dashed #d4d4d8;
    }
  }
</style>
