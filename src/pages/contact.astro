---
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";

const channels = [
  {
    title: "Orders, billing, and server support",
    handle: "Client Panel",
    description:
      "Open your service and use its private support channel for questions about your account, payment, or server.",
    href: "https://my.8labs.id",
    cta: "Open Client Panel",
    icon: "bi:life-preserver",
    external: true,
  },
  {
    title: "Telegram",
    handle: "@virtual_8labs",
    description:
      "Ask a general question in the community. Keep account and order details private.",
    href: "https://t.me/virtual_8labs",
    cta: "Open Telegram",
    icon: "bi:telegram",
    external: true,
  },
  {
    title: "Email",
    handle: "hey@raska.id",
    description:
      "Email us for general enquiries or if you cannot access Client Panel.",
    href: "mailto:hey@raska.id",
    cta: "Send an email",
    icon: "bi:envelope",
    external: false,
  },
];
---

<Layout title="Contact">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Contact</Fragment>
      <Fragment slot="desc"
        >Pick the channel that fits your question. Account and server issues go
        through Client Panel so they stay private.</Fragment
      >
    </Sectionhead>

    <div class="mt-12 grid gap-10 md:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-2xl font-medium tracking-[-0.02em] text-line">
          Need help with an order or server?
        </h2>
        <p class="mt-3 max-w-xl text-base leading-7 text-muted">
          Open your service in Client Panel to contact support. If you are
          reporting a problem,{" "}
          <a
            href="/docs/help/contact/"
            class="font-medium text-red-ink underline"
            >see what to include in your message</a
          >.
        </p>
        <div class="mt-6 flex items-center gap-2 text-muted">
          <Icon class="h-4 w-4 text-red-ink" name="bi:geo-alt" />
          <span>Based in Indonesia</span>
        </div>
      </div>

      <div class="flex flex-col gap-px border border-grid bg-grid">
        {
          channels.map((c) => (
            <a
              href={c.href}
              target={c.external ? "_blank" : undefined}
              rel={c.external ? "noopener noreferrer" : undefined}
              class="group bg-panel p-6 transition-colors hover:bg-surface">
              <div class="flex items-start gap-4">
                <div class="shrink-0 pt-1 text-muted">
                  <Icon class="h-5 w-5" name={c.icon} />
                </div>
                <div>
                  <h3 class="text-lg font-medium tracking-[-0.02em] text-line">
                    {c.title}
                  </h3>
                  <p class="text-sm font-medium text-red-ink">{c.handle}</p>
                  <p class="mt-2 text-sm leading-7 text-cool">
                    {c.description}
                  </p>
                  <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-red-ink">
                    {c.cta}
                    <Icon
                      class="h-4 w-4 transition-transform duration-150 ease-out group-hover:translate-x-0.5"
                      name="bx:right-arrow-alt"
                    />
                  </span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </Container>
</Layout>
