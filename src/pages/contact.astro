---
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";

const channels = [
  {
    title: "Telegram",
    handle: "@virtual_8labs",
    description:
      "Fastest reply. Best for quick questions and provisioning help.",
    href: "https://t.me/virtual_8labs",
    cta: "Open Telegram",
    icon: "bi:telegram",
    external: true,
  },
  {
    title: "Email",
    handle: "hey@raska.id",
    description:
      "Better for billing, account, or anything that needs a record.",
    href: "mailto:hey@raska.id",
    cta: "Send an email",
    icon: "bi:envelope",
    external: false,
  },
];
---

<Layout title="Contact">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Contact</Fragment>
      <Fragment slot="desc">We are here to help.</Fragment>
    </Sectionhead>

    <div class="mt-12 grid gap-10 md:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-2xl font-medium tracking-[-0.02em] text-line">
          Reach the 8Labs team.
        </h2>
        <p class="mt-3 max-w-xl text-base leading-7 text-muted">
          Questions about a lab, billing, or your account? Message us on
          Telegram for the fastest reply, or email us if you need a paper trail.
          For provisioning and order issues, the
          <a
            href="https://my.8labs.id"
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-red-ink underline-offset-2 hover:underline"
            >client panel</a
          > support path is usually quickest.
        </p>
        <div class="mt-6 flex items-center gap-2 text-muted">
          <Icon class="h-4 w-4 text-red-ink" name="bi:pin-map" />
          <span>Indonesia</span>
        </div>
      </div>

      <div class="flex flex-col gap-4">
        {
          channels.map((c) => (
            <a
              href={c.href}
              target={c.external ? "_blank" : undefined}
              rel={c.external ? "noopener noreferrer" : undefined}
              class="rounded-lg border border-grid bg-panel p-6 transition-colors hover:border-red-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-red-ink">
              <div class="flex items-start gap-4">
                <div class="shrink-0 pt-1 text-muted">
                  <Icon class="h-5 w-5" name={c.icon} />
                </div>
                <div>
                  <h2 class="text-lg font-medium tracking-[-0.02em] text-line">
                    {c.title}
                  </h2>
                  <p class="text-sm font-medium text-red-ink">{c.handle}</p>
                  <p class="mt-2 text-sm leading-7 text-cool">
                    {c.description}
                  </p>
                  <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-red-ink">
                    {c.cta}
                    <Icon class="h-4 w-4" name="bx:right-arrow-alt" />
                  </span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </Container>
</Layout>
