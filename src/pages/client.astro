---
import Container from "@components/container.astro";
import Layout from "@layouts/Layout.astro";
---

<Layout title="Client Panel">
  <Container>
    <section class="flex min-h-[calc(100vh-16rem)] items-center py-16">
      <div class="w-full max-w-2xl border border-grid bg-panel p-6 sm:p-10">
        <h1
          class="text-3xl font-medium tracking-[-0.03em] text-line sm:text-4xl">
          Open Client Panel
        </h1>
        <p class="mt-4 text-base leading-7 text-muted">
          Client Panel is where you order labs, pay invoices, and reach private
          support. It lives at my.8labs.id.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-5">
          <a
            class="inline-flex min-h-11 items-center border border-red-ink bg-red-ink px-5 py-2.5 text-sm font-medium text-white transition-[background-color,transform] duration-150 ease-out hover:bg-red-800 active:scale-[0.97]"
            href="https://my.8labs.id">Go to my.8labs.id</a
          >
          <a
            class="inline-flex min-h-11 items-center text-sm font-medium text-line underline underline-offset-4"
            href="/">Back to home</a
          >
        </div>
      </div>
    </section>
  </Container>
</Layout>
