---
import Container from "@components/container.astro";
import Layout from "@layouts/Layout.astro";
---

<Layout title="Cloud Panel">
  <Container>
    <section class="flex min-h-[calc(100vh-16rem)] items-center py-16">
      <div
        class="w-full max-w-2xl rounded-lg border border-grid bg-panel p-6 sm:p-10">
        <h1
          class="text-3xl font-medium tracking-[-0.03em] text-line sm:text-4xl">
          Continue to the cloud panel
        </h1>
        <p class="mt-4 text-base leading-7 text-muted">
          Select the link below to continue to cloud.8labs.id.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-5">
          <a
            class="inline-flex rounded-md bg-red-ink px-5 py-3 text-sm font-medium text-white transition-colors hover:bg-red-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-red-ink"
            href="https://cloud.8labs.id">Open cloud panel</a
          >
          <a
            class="text-sm font-medium text-cool underline-offset-4 hover:underline"
            href="/">Back to home</a
          >
        </div>
      </div>
    </section>
  </Container>
</Layout>
