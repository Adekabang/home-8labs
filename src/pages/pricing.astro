---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";

import { families } from "../lib/catalog";
---

<Layout title="Pricing">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Compare lab plans</Fragment>
      <Fragment slot="desc"
        >Five lab families, side by side. Virtual Labs is the free tier, paid in
        LAB Coin. The rest are billed in Indonesian rupiah. Client Panel shows
        current prices and stock.</Fragment
      >
    </Sectionhead>
    <div
      class="mt-10 grid gap-px border border-grid bg-grid md:grid-cols-2 lg:grid-cols-3">
      {
        families.map((family) => (
          <section class="flex flex-col bg-panel p-6">
            <h2 class="text-xl font-medium text-line">
              {family.name}
              {family.paused && (
                <span class="micro-label ml-2 align-middle">Paused</span>
              )}
            </h2>
            <dl class="my-5 grid gap-3 text-sm leading-6">
              {Object.entries({
                "Best for": family.use,
                "VM placement": family.placement,
                Network: family.network,
                "Billed in": family.unit,
              }).map(([label, value]) => (
                <div>
                  <dt class="micro-label">{label}</dt>
                  <dd class="mt-0.5 text-line">{value}</dd>
                </div>
              ))}
            </dl>
            <a
              class="mt-auto inline-flex min-h-11 items-center text-sm font-medium text-red-ink underline underline-offset-4"
              href={`https://my.8labs.id/products/${family.slug}`}>
              View {family.name} plans
            </a>
          </section>
        ))
      }
      <aside
        class="bg-surface p-6 text-sm leading-6 text-cool md:col-span-2 lg:col-span-1">
        <h2 class="text-xl font-medium text-line">Before you order</h2>
        <p class="mt-5">
          Check the price, stock, and renewal terms of the plan you pick in
          Client Panel. Stock is limited and sells out quickly.
        </p>
        <p class="mt-3">
          Keep your own backup of anything important. A snapshot stored with the
          server is not an external backup.
        </p>
        <a
          class="mt-3 inline-flex min-h-11 items-center font-medium text-red-ink underline underline-offset-4"
          href="/docs/billing-plans/overview/">How billing works</a
        >
      </aside>
    </div>
  </Container>
</Layout>
