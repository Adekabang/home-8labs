---
import Layout from '@layouts/Layout.astro';
import Container from '@components/container.astro';
import Sectionhead from '@components/sectionhead.astro';

const families = [
  {name: 'Virtual Labs', slug: 'virtual-labs', use: 'Learning and short experiments', placement: 'Nested hypervisor', network: 'IPv6 first; selected plans include IPv4', unit: 'LAB Coin'},
  {name: 'Virtual Dedicated Labs', slug: 'virtual-dedicated-labs', use: 'Steady VM workloads', placement: 'Directly on a bare-metal hypervisor', network: 'Public IPv6', unit: 'IDR'},
  {name: 'CloudLabs', slug: 'cloudlabs', use: 'Projects that need higher bandwidth', placement: 'Check the plan details', network: 'Public IPv4 and IPv6 options', unit: 'IDR'},
  {name: 'ElasticLabs', slug: 'elasticlabs', use: 'Projects with growing resource needs', placement: 'Directly on a bare-metal hypervisor', network: 'Public IP options vary by plan', unit: 'IDR'},
  {name: 'ElasticLabs NAT', slug: 'elasticlabs-nat', use: 'Lower-cost labs with shared access', placement: 'Check the plan details', network: 'Private IPv4 behind a shared public address', unit: 'IDR'},
];
---
<Layout title="Pricing">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Compare lab plans</Fragment>
      <Fragment slot="desc">Check current prices and availability in Client Panel. Virtual Labs uses LAB Coin. Other families list prices in Indonesian rupiah (IDR).</Fragment>
    </Sectionhead>
    <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {families.map(family => <section class="flex flex-col rounded-lg border border-grid bg-panel p-6">
        <h2 class="text-xl font-medium text-line">{family.name}</h2>
        <dl class="my-5 grid gap-3 text-sm leading-6">
          {Object.entries({'Best for': family.use, 'VM placement': family.placement, 'Network': family.network, 'Billing unit': family.unit}).map(([label,value]) => <div><dt class="font-medium text-line">{label}</dt><dd class="text-cool">{value}</dd></div>)}
        </dl>
        <a class="mt-auto inline-flex min-h-11 items-center font-medium text-red-ink underline" href={`https://my.8labs.id/products/${family.slug}`}>View {family.name} plans</a>
      </section>)}
    </div>
    <aside class="mt-10 max-w-3xl rounded-lg border border-grid bg-surface p-6 leading-7 text-cool">
      <h2 class="text-xl font-medium text-line">Before ordering</h2>
      <p class="mt-2">Check the location, network limits, renewal terms, and final price for the plan you select. Keep an independent backup of important data. An on-server snapshot is not an external backup.</p>
    </aside>
  </Container>
</Layout>
