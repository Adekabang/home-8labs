---
import Container from "@components/container.astro";
import Layout from "@layouts/Layout.astro";
---

<Layout title="404 Not Found">
  <Container>
    <section class="flex min-h-[calc(100vh-16rem)] items-center py-16">
      <div class="w-full max-w-2xl border border-grid bg-panel p-6 sm:p-10">
        <p class="micro-label">Error 404</p>
        <h1
          class="mt-3 text-3xl font-medium tracking-[-0.03em] text-line sm:text-4xl">
          Page not found
        </h1>
        <p class="mt-4 max-w-lg text-base leading-7 text-muted">
          Nothing lives at this address. The page may have moved, or the link
          may be mistyped.
        </p>
        <a
          class="mt-8 inline-flex min-h-11 items-center border border-red-ink bg-red-ink px-5 py-2.5 text-sm font-medium text-white transition-[background-color,transform] duration-150 ease-out hover:bg-red-800 active:scale-[0.97]"
          href="/">Back to home</a
        >
        <a
          href="/docs/"
          class="ml-4 inline-flex min-h-11 items-center text-sm font-medium text-line underline underline-offset-4"
          >Search the docs</a
        >
      </div>
    </section>
  </Container>
</Layout>
