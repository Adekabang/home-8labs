---
import Container from "@components/container.astro";
import Layout from "@layouts/Layout.astro";
---

<Layout title="404 Not Found">
  <Container>
    <section class="flex min-h-[calc(100vh-16rem)] items-center py-16">
      <div
        class="w-full max-w-2xl rounded-lg border border-grid bg-panel p-6 sm:p-10">
        <p class="text-sm font-medium text-muted">Error 404</p>
        <h1
          class="mt-3 text-3xl font-medium tracking-[-0.03em] text-line sm:text-4xl">
          Page not found
        </h1>
        <p class="mt-4 max-w-lg text-base leading-7 text-muted">
          This address does not point to a page. Head back to the 8Labs home
          page to find labs, services, and documentation.
        </p>
        <a
          class="mt-8 inline-flex rounded-md bg-red-ink px-5 py-3 text-sm font-medium text-white transition-colors hover:bg-red-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-red-ink"
          href="/">Back to home</a
        >
      </div>
    </section>
  </Container>
</Layout>
